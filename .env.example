# Copy to .env and adjust. Taskfile loads .env automatically.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/easyrent?sslmode=disable
ADDR=:8080
# 32+ random bytes for HS256 access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ACCESS_TOKEN_SECRET=change-me-to-32-or-more-random-bytes
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30
# Resend (https://resend.com/api-keys). Test sender only delivers to your
# own Resend account address until you verify a domain.
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=EasyRent <onboarding@resend.dev>
APP_URL=http://localhost:8080
